<configuration>
  <property
      name="CONSOLE_PATTERN"
      value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n%ex{short}" />

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_PATTERN}</pattern>
    </encoder>
  </appender>

  <logger name="com.example.urlshortener" level="INFO" />
  <logger name="com.example.urlshortener.service.LinkServiceImpl" level="TRACE" />

  <root level="INFO">
    <appender-ref ref="CONSOLE" />
  </root>
</configuration>